<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36" pages="3">
  <diagram name="vogons" id="SrBoWMdKzE5dempknB0G">
    <mxGraphModel dx="6415" dy="3578" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4681" pageHeight="3300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="50ucFm-BoPKFnqNqtuyX-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="3300" width="4680" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=128;spacingLeft=16;fontFamily=Courier New;fontStyle=1" value="VOGON POETRY" vertex="1">
          <mxGeometry height="340" width="720" x="160" y="160" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=62;spacingLeft=16;fontFamily=Courier New;fontStyle=0;" value="shaurya&lt;div&gt;agarwal&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="320" x="960" y="350" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=56;spacingLeft=16;fontFamily=Helvetica;" value="Revisiting data engineering concepts with an eye for maximizing value in an AI-driven value chain" vertex="1">
          <mxGeometry height="350" width="690" x="310" y="500" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-7" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="2440" width="2440" x="2040" y="680" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-6" parent="oON_mjBSMZg2AIRH7poi-7" style="rounded=0;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1A1A1A;strokeColor=#FFFFFF;" value="" vertex="1">
          <mxGeometry height="2440" width="2440" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-4" parent="oON_mjBSMZg2AIRH7poi-7" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="2310" width="2388.07" x="25.964999999999918" y="65" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;align=left;verticalAlign=middle;spacingLeft=16;fontFamily=Helvetica;fontSize=32;fontColor=default;fillColor=none;gradientColor=none;fontStyle=0;spacing=24;treeFolding=0;" value="&lt;div&gt;AI is fast becoming the core value engine. The differentiator is no longer the model, but the ability to address determinism, correctness, latency and unit costs. Data Engineering must be looked at from this lens.&amp;nbsp;&lt;/div&gt;&lt;div&gt;In this fast evolving ecosystem, the expert-novice data engineer gap cannot be addressed by building tool fluency, but instead building a high quality understanding of a pedagogy of core concepts \- a core set of transferrable mental models that unlock analysis and prediction of behaviour across tools and systems \- prevalent and emergent.&amp;nbsp;&lt;/div&gt;&lt;div&gt;This paper organizes these mental models as concepts, classified into &quot;instincts&quot; \- invariant ideas that govern a class of decisions, grouped into &quot;families&quot; \- that form the general heuristic idea in data engineering. Honestly, when read together \- these sound like a poem that would make Prostetnic Vogon Jeltz slurp his axlegrurts hagrilly. Hence the name.&amp;nbsp;&lt;/div&gt;&lt;div&gt;The families function as a dependency structure rather than a taxonomy. A decision in one family, such as file layout under &quot;storage as a substrate,&quot; propagates predictable consequences in others, such as scan cost under &quot;mechanical sympathy&quot; and shuffle volume under &quot;distribution.&quot;&amp;nbsp;&lt;/div&gt;&lt;div&gt;The author claims that familiarity with these concepts first, then attaching tools to them, yields faster transfer to unfamiliar systems than tool-first instruction, because these mental models largely act as invariants and remain stable while interfaces change. This paper presents&amp;nbsp; the map, the concept graph, and the reasoning each instinct supports, with banking and reinsurance as the primary worked domains.&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="3200" x="1280" y="240" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=42;spacingLeft=16;fontFamily=Helvetica;fontStyle=0;fontColor=#3333FF;" value="&lt;a href=&quot;https://shauryashaurya.github.io/vogon-poetry/vogon-poetry-concept-viewer/&quot;&gt;interactive viewer&lt;/a&gt;" vertex="1">
          <mxGeometry height="80" width="750" x="1280" y="840" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-11" parent="1" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="680" width="680" x="1320" y="960" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;align=left;verticalAlign=bottom;spacingLeft=16;fontFamily=Helvetica;fontSize=32;fontColor=default;fontStyle=0;fillColor=none;gradientColor=none;" value="&lt;span style=&quot;font-size: 41px;&quot;&gt;*...As plurdled gabbleblotchits on a lurgid bee...*&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 41px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 41px;&quot;&gt;&lt;span style=&quot;font-size: 41px;&quot;&gt;By order of Galactic Hyperspace Planning Council,&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 41px;&quot;&gt;&lt;span style=&quot;font-size: 41px;&quot;&gt;Recitation shall now begin, without mercy.&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 41px;&quot;&gt;&lt;span style=&quot;font-size: 41px;&quot;&gt;Resistance is useless...&lt;/span&gt;" vertex="1">
          <mxGeometry height="240" width="1120" x="160" y="920" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-17" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;A Mechanical Sympathy&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;Physical form dominates performance&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;Movement is the cost&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;Batch beats tuple-at-a-time&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="850" x="160" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-18" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;B Do Less And Prove It&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;Declare what; let the planner choose how&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;The fastest work is skipped work&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;Approximate on purpose&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="850" x="430" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="oON_mjBSMZg2AIRH7poi-19" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;C Distribution&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;Placement decides what is cheap&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="850" x="150" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="50ucFm-BoPKFnqNqtuyX-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;D State, Time, And Safe Re-runs&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;Durability is an append-only log plus a snapshot&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;Time and ordering are plural and uncertain&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;Design every pipeline to be safe to re-run&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="1110" x="850" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="50ucFm-BoPKFnqNqtuyX-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;E Storage As A Substrate&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400;&quot;&gt;A table is metadata over immutable files&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 32px; font-weight: 400;&quot;&gt;Compose interchangeable layers through open standards&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="310" width="910" x="180" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="50ucFm-BoPKFnqNqtuyX-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;F Operating Under Load And Trust&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400;&quot;&gt;A system that cannot say no will fail&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Data is a product with a contract&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="260" width="1090" x="770" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="50ucFm-BoPKFnqNqtuyX-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;G Policy And Economics&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400;&quot;&gt;Enforce policy at the chokepoint&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cost is an architecture decision&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="260" width="930" x="160" y="2620" as="geometry" />
        </mxCell>
        <mxCell id="50ucFm-BoPKFnqNqtuyX-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=27;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;H Data For AI&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400;&quot;&gt;Meaning becomes geometry&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 32px; font-weight: 400; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Feed the accelerator&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="260" width="710" x="1020" y="2700" as="geometry" />
        </mxCell>
        <mxCell id="50ucFm-BoPKFnqNqtuyX-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;align=right;verticalAlign=bottom;spacingLeft=16;fontFamily=Courier New;fontSize=32;fontColor=default;fontStyle=0;fillColor=none;gradientColor=none;" value="&lt;div&gt;&lt;span style=&quot;font-size: 41px;&quot;&gt;There.&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 41px;&quot;&gt;You may now applaud.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1830" x="160" y="2960" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
